# ---- Core ----
ENVIRONMENT=development
# Comma-separated origins allowed by CORS
CORS_ORIGINS=http://localhost:3000

# ---- Database (matches infra/docker-compose.yml) ----
POSTGRES_USER=persona
POSTGRES_PASSWORD=persona
POSTGRES_DB=persona
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Async SQLAlchemy URL; built from the parts above if left unset
DATABASE_URL=postgresql+asyncpg://persona:persona@localhost:5432/persona

# ---- Redis / Celery ----
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ---- Security ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me-in-production
# Fernet key for encrypting OAuth tokens at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=change-me-32-byte-urlsafe-base64=
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=30

# ---- AI providers ----
# LLM_PROVIDER: anthropic | openai | gemini | fake
LLM_PROVIDER=fake
LLM_MODEL_FAST=claude-haiku-4-5-20251001
LLM_MODEL_STRONG=claude-opus-4-8
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# EMBEDDING_PROVIDER: fastembed | openai | voyage | gemini | fake
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
VOYAGE_API_KEY=

# ---- OAuth (login + connectors) ----
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:3000/api/backend/auth/github/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/backend/auth/google/callback

# ---- Email (Mailpit in dev) ----
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@personaai.local

# ---- Storage ----
# STORAGE_BACKEND: local | s3
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./data/uploads
S3_BUCKET=
S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---- Observability ----
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=INFO
